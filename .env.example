PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=purisunny

# --- Production database (required when NODE_ENV=production) -----------------
# config/db.js refuses to boot in production unless DB_HOST, DB_USER,
# DB_PASSWORD and DB_NAME are all set (an unset value means "not configured",
# an empty DB_PASSWORD is allowed but must be set explicitly).
#
# Optional pool tuning:
#   DB_PORT          default 3306
#   DB_QUEUE_LIMIT   max queued requests waiting for a connection, default 100

# Required. Minimum 32 characters or the server refuses to boot.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- CORS --------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# Development:
#   http://localhost:3000   Next.js website
#   http://localhost:3001   Vite admin dashboard
# Production MUST list BOTH public origins, e.g.:
#   CORS_ORIGIN=https://purisunnymunduk.id,https://www.purisunnymunduk.id,https://admin.purisunnymunduk.id
# where https://purisunnymunduk.id is the public website and https://admin.purisunnymunduk.id
# is the static host serving the built admin dashboard (see README "Deployment").
# Never leave this as '*' in production.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Where the Next.js frontend lives. The backend POSTs /api/revalidate here after
# an article/SEO mutation. On a single host this is the internal Next.js address
# (e.g. http://127.0.0.1:3000); on separate hosts use the public website origin.
FRONTEND_INTERNAL_URL=http://localhost:3000
# Shared secret must match the frontend REVALIDATE_SECRET. Set a real value in .env.
REVALIDATE_SECRET=change-me

# Set to 1 only when deployed behind a trusted reverse proxy (nginx/PaaS/CDN),
# so rate limiting sees the real client IP via X-Forwarded-For.
TRUST_PROXY=0

# Optional: password for the seeded admin account. If unset, seed.js generates a
# random password and prints it once. Never commit a real value.
ADMIN_PASSWORD=

# Image uploads (Cloudinary). Never commit real credentials.
# POST /api/upload is admin-only (see backend/middleware/auth.js).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=purisunny

# --- Contact form email (optional until the domain inbox exists) -------------
# POST /api/contact always stores the row in `contacts`, then emails EMAIL_TO.
# Sending is enabled only when EMAIL_HOST, EMAIL_USER and EMAIL_PASS are all
# set; until then the form answers 502 + fallback: 'whatsapp' instead of
# pretending the message was delivered. See EMAIL-SETUP.md in the repo root.
# Never commit real values — .env is gitignored.
#   EMAIL_PORT      default 465 (implicit TLS); use 587 for STARTTLS
#   EMAIL_SECURE    default: true on port 465, false otherwise
#   EMAIL_FROM      default admin@purisunnymunduk.id
#   EMAIL_FROM_NAME default "Puri Sunny Website"
#   EMAIL_TO        default purisunnybali@gmail.com
# Test with: npm run mail:test
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=
EMAIL_TO=

# --- Agent API (Phase 1) ------------------------------------------------------
# Kill switch: set to 0 or false to answer 503 for every /api/agent/v1 request.
AGENT_API_ENABLED=1
# Max request body for agent routes only (legacy /api keeps the 100kb limit).
AGENT_BODY_LIMIT=2mb
# Larger JSON limit for /api/agent/v1/media (base64 images, 5MB decoded max).
AGENT_MEDIA_BODY_LIMIT=8mb
# Per-API-key rate limits (requests per minute).
AGENT_RATE_LIMIT_READ=120
AGENT_RATE_LIMIT_WRITE=30
# Per-IP failed-authentication limit (requests per minute).
AGENT_AUTH_FAILURE_LIMIT=20
# Idempotency-Key retention. A completed response replays for this many hours.
AGENT_IDEMPOTENCY_TTL_HOURS=24
# agent_audit_log retention. `npm run agent:purge` deletes older rows.
AGENT_AUDIT_RETENTION_DAYS=90
# Optional absolute base URL advertised by /manifest and /openapi.json.
# Leave empty to advertise the relative /api/agent/v1 path.
PUBLIC_API_BASE_URL=

# --- Admin dashboard build (admin-dashboard/.env.production) -----------------
# Vite inlines VITE_* variables at build time. Point it at the public API origin
# (not /api-relative) when the dashboard is served from a different host than the
# backend:
#   VITE_API_URL=https://api.purisunnymunduk.id/api
# That origin must also appear in CORS_ORIGIN above. See README "Deployment".
